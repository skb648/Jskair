<?xml version="1.0" encoding="utf-8"?>
<!--
  L-08 Fix: Per-app language configuration for Android 13+ (API 33+).
  
  This allows users to select AirControl's language independently from the
  system language via Settings > System > Languages & input > App languages.
  
  English (default) and Hindi (hi) are supported (Fix U10).
  
  See: https://developer.android.com/guide/topics/resources/app-languages
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="hi" />
</locale-config>
