<?xml version="1.0" encoding="utf-8"?>
<!--
    Accessibility is used for two distinct purposes:
    1) dispatching enabled user actions; and
    2) native-like cursor feedback, which reads a small, bounded snapshot of
       the window/node metadata under the cursor (class, bounds, clickable,
       editable, supported click action). No raw AccessibilityNodeInfo is
       retained after the lookup.
-->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description_precise"
    android:settingsActivity="com.aircontrol.SettingsDeepLinkActivity" />
