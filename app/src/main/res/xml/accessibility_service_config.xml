<?xml version="1.0" encoding="utf-8"?>
<!-- Fix #46, #47, #98 (+ note from the reliability pass): gesture injection
     only needs canPerformGestures. onAccessibilityEvent() is intentionally
     empty — gestures come from the camera pipeline, not accessibility events.
     typeWindowStateChanged is still declared on purpose: with no event type at
     all some OEM skins treat the service as an idle/low-priority a11y client,
     which is precisely the class of bug where the service "shows On in
     Settings but does nothing". The single event type costs one ignored binder
     callback per window change.

     Native-like cursor (hover context): canRetrieveWindowContent=true +
     flagRetrieveInteractiveWindows now let the service READ the node under the
     cursor (debounced, movement-only, background thread) so the pointer can
     switch to HAND/IBEAM like a real mouse. This is strictly read-only; it
     does not add any gesture/action capability and does not change the
     existing dispatch semantics.
     settingsActivity points to SettingsDeepLinkActivity, which routes into the
     in-app Settings screen. -->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="true"
    android:description="@string/accessibility_service_description"
    android:settingsActivity="com.aircontrol.SettingsDeepLinkActivity" />
