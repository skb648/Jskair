<?xml version="1.0" encoding="utf-8"?>
<!-- Fix #46, #47, #98 (+ note from the reliability pass): we never read window
     content, so the contradictory flags (flagRetrieveInteractiveWindows /
     flagIncludeNotImportantViews) are absent and canRetrieveWindowContent=false.
     onAccessibilityEvent() is intentionally empty - gestures come from the camera
     pipeline, not from accessibility events. typeWindowStateChanged is still
     declared on purpose: with no event type at all some OEM skins treat the
     service as an idle/low-priority a11y client, which is precisely the class of
     bug where the service "shows On in Settings but does nothing". The single
     event type costs one ignored binder callback per window change.
     settingsActivity points to SettingsDeepLinkActivity, which routes into the
     in-app Settings screen. -->
<accessibility-service
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault"
    android:canPerformGestures="true"
    android:notificationTimeout="100"
    android:canRetrieveWindowContent="false"
    android:description="@string/accessibility_service_description"
    android:settingsActivity="com.aircontrol.SettingsDeepLinkActivity" />
