<?xml version="1.0" encoding="utf-8"?>
<!--
  L-07 Fix: Explicit data extraction rules for Android 12+ (API 31+).
  
  AirControl stores sensitive user preferences locally and should NOT be
  backed up to Google Drive or transferred to a new device. This is both
  a privacy choice (no cloud backup of preferences) and a technical safety
  measure (calibration data is device-specific and won't work on another device).
  
  See: https://developer.android.com/guide/topics/data/backup-test-restore
-->
<data-extraction-rules>
    <!-- Disable all cloud backup -->
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    
    <!-- Disable device-to-device transfer -->
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
