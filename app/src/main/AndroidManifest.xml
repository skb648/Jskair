<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!-- Fix #88: specialUse removed (we never pass SPECIAL_USE to startForeground and
         it triggers a Play policy declaration for zero functional gain). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- MediaPipe tasks-core transitively contributes Google Data Transport permissions.
         AirControl performs all inference on-device, so remove them from the final APK. -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />

    <application
        android:name=".AirControlApp"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirControl">
        <!-- Fix #45: removed networkSecurityConfig since we don't have INTERNET. -->

        <!-- Fix #98: add a dedicated SettingsActivity alias so system a11y settings
             don't land on the splash-themed MainActivity. We'll just mark this
             activity with launchDocument=always to ensure it routes into settings.
             Simpler: set android:settingsActivity pointing to a SettingsActivity.
             Since there is no separate SettingsActivity, we re-use MainActivity
             with an extra that navigates to the Settings route. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.AirControl.Splash"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|locale|layoutDirection|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsDeepLinkActivity"
            android:exported="true"
            android:theme="@style/Theme.AirControl.Splash"
            android:excludeFromRecents="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.action.SETTINGS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".camera.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera"
            android:stopWithTask="false" />
        <!-- Fix #88: foregroundServiceType is camera only; removed specialUse + property. -->

        <service
            android:name=".accessibility.GestureControlAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/accessibility_service_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
            <!-- Fix #46: set canRetrieveWindowContent correctly. We don't read window
                 content; remove the contradictory flags in the config XML. -->
        </service>

        <!-- Fix #17: receiver is NOT directBootAware and does NOT listen for
             LOCKED_BOOT_COMPLETED, so it never runs pre-unlock and can safely
             use credential-encrypted DataStore. -->
        <receiver
            android:name=".receiver.BootCompletedReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
